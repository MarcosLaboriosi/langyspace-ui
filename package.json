{
  "name": "@langyspace/ui",
  "version": "1.0.0",
  "description": "Shared React UI primitives for Langy.space products.",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "audit",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audit": "./audit/index.mjs"
  },
  "bin": {
    "langyspace-ui-audit": "./audit/cli.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:storybook": "storybook build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:storybook": "vitest run --project storybook",
    "test:unit": "vitest run --project unit",
    "test:button-system": "node audit/cli.mjs scripts/button-system.audit.config.mjs && node scripts/test-architecture-audit.mjs",
    "test:layout": "pnpm run build:storybook && node scripts/audit-storybook-layout.mjs",
    "test:package": "node scripts/smoke-test-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate:ui": "pnpm run test:button-system && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm test && pnpm run build && pnpm run test:package && LAYOUT_AUDIT_SCREENSHOTS=1 pnpm run test:layout"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "styled-components": ">=6 <7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "playwright": "1.61.1",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "10.5.10",
    "styled-components": "^6.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.8"
  }
}
